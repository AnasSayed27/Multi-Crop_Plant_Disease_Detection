    { "id": "wal-to-pdf", "from": "sqlite_wal", "to": "pdf_report", "label": "scan data", "classification": "audit facts", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "labelDy": 24 }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Transformation Pipeline",
      "items": [
        "Foliar images are decoded via PIL into 224x224 RGB tensors normalized with ImageNet statistics",
        "ViT-Base architecture maps 16x16 visual patches into a dense 768-dimensional visual feature vector",
        "Two linear heads concurrently generate softmax probabilities across 55 crop species and 175 diseases"
      ]
    },
    {
      "dot": "cyan",
      "title": "Probabilistic Cross-Join",
      "items": [
        "The 55x175 product space (9,625 pairs) is filtered through a 333-pair viable agricultural taxonomy mask",
        "Confidence is calculated as sqrt(P_plant * P_disease) * 100 to guarantee monotonic ranking",
        "Top-3 predictions are dynamically matched to symptomology and treatment protocols in disease_info.json"
      ]
    },
    {
      "dot": "rose",
      "title": "Auditability & Reports",
      "items": [
        "Authenticated farmer accounts link each diagnosis to a timestamped SQLite WAL telemetry record",
        "Non-crop or low-confidence scans (<40%) are flagged to prevent epidemiological database pollution",
        "Full differential diagnostic reports are compiled on-demand into printable PDF documents"
      ]
    }
  ]
}
