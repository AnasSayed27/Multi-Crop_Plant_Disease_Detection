    { "id": "auth-to-tax", "from": "token_auth", "to": "taxonomy_store", "label": "authenticated", "classification": "session id", "variant": "default", "route": "straight" },
    { "id": "vit-to-logits", "from": "vit_latent", "to": "dual_logits", "label": "768-d embedding", "classification": "latent vector", "variant": "emphasis", "route": "straight" },
