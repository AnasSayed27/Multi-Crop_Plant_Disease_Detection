  ],
  "nodes": [
    { "id": "raw_photo", "type": "frontend", "label": "Foliar Image", "sublabel": "RGB Camera / File", "stage": 0, "row": 0, "tag": "raw bytes" },
    { "id": "client_meta", "type": "external", "label": "Farmer Session", "sublabel": "User Auth Session", "stage": 0, "row": 2, "tag": "JWT token" },
    { "id": "pil_tensor", "type": "backend", "label": "Tensor Transform", "sublabel": "224x224 Normalize", "stage": 1, "row": 0, "tag": "Float32" },
    { "id": "token_auth", "type": "security", "label": "Auth Validator", "sublabel": "MIME & Auth Gating", "stage": 1, "row": 2, "tag": "verified user" },
