    {
      "dot": "cyan",
      "title": "Dual-Head Vision Transformer",
      "items": [
        "Pretrained ViT-Base backbone extracts a unified 768-dimensional visual embedding",
        "Two parallel linear classification heads evaluate 55 plant species and 175 pathological conditions",
        "Joint probability scoring evaluates all 333 valid crop-disease pairings with geometric-mean confidence"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application & Data Layer",
      "items": [
        "FastAPI handles async REST requests with schema validation and MIME verification",
        "SQLite runs in Write-Ahead Logging (WAL) mode for low-latency concurrent writes",
        "ReportLab dynamically compiles clinical diagnostic reports with differential diagnoses"
      ]
    },
    {
      "dot": "rose",
      "title": "Clinical Advisory & Safety",
      "items": [
        "Every diagnosis links to a verified 5-pillar treatment plan (organic, chemical, prevention, pesticides, fertilizers)",
        "Out-of-domain and non-crop images trigger automated rejection with confidence thresholding (<40%)",
        "Upload directory is strictly sandboxed to prevent path traversal or unsafe file execution"
      ]
    }
